    "configuration",
    "constants",
    "llm-settings",
    "thresholds"
   ],
   "complexity": "moderate",
   "languageNotes": "Model IDs and the provider can be overridden through MASTRA_* environment variables read at import time, so the effective configuration is fixed when the module is first imported."
  },
