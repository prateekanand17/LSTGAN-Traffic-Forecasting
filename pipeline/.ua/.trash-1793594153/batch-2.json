  "nodes": [
    {
      "id": "file:coordination/agents.py",
      "type": "file",
      "name": "agents.py",
      "filePath": "coordination/agents.py",
      "summary": "Defines the shared zone-agent interface (propose and revise) so deterministic rule agents and LLM-backed agents run inside the same coordination protocols, along with the local context and neighbour messages they exchange.",
      "tags": [
        "agent",
        "coordination",
        "factory",
        "multi-agent",
        "strategy-pattern"
      ],
      "complexity": "moderate"
    },
    {
      "id": "file:coordination/common.py",
      "type": "file",
      "name": "common.py",
      "filePath": "coordination/common.py",
      "summary": "Provides the deterministic coordination primitives shared by agents, coordinators and evaluation metrics: candidate corridor ranking, the priority order, communication topologies, and the single definition of reroute conflicts.",
      "tags": [
        "coordination",
        "utility",
        "conflict-detection",
        "graph-topology",
        "geospatial"
      ],
      "complexity": "moderate"
    },
    {
      "id": "file:coordination/coordinators.py",
      "type": "file",
      "name": "coordinators.py",
      "filePath": "coordination/coordinators.py",
      "summary": "Implements the centralized coordinators used in the centralized design cells and as the fallback after negotiation: a greedy priority-based rule coordinator and an LLM Global Supervisor, both with a global view of every zone.",
      "tags": [
        "coordination",
        "centralized",
        "orchestration",
        "fallback",
        "greedy-algorithm"
      ],
      "complexity": "moderate"
    },
    {
      "id": "file:coordination/negotiation.py",
      "type": "file",
      "name": "negotiation.py",
      "filePath": "coordination/negotiation.py",
      "summary": "Runs the round-based negotiation loop in which zone agents exchange proposals only with topology neighbours, see only conflicts with those neighbours, and revise until no conflict is visible, nothing changes, or the round limit is reached.",
      "tags": [
        "coordination",
        "negotiation",
        "multi-agent",
        "protocol",
        "decentralized"
      ],
      "complexity": "moderate",
      "languageNotes": "The negotiation loop uses Python's for-else: the else branch runs only when all rounds complete without a break, which is where the final conflict re-check happens."
    },
    {
      "id": "file:generate/rules.py",
      "type": "file",
      "name": "rules.py",
      "filePath": "generate/rules.py",
      "summary": "Generates deterministic advisory content without an LLM, used by RuleAgent and the dry-run stand-in: severities from the detector or the per-horizon forecast, plus one reroute to the fastest free candidate corridor for HIGH or MEDIUM zones.",
      "tags": [
        "rule-based",
        "advisory",
        "deterministic",
        "utility"
      ],
      "complexity": "simple"
    },
