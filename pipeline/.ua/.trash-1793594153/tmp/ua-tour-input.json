raph/zone_state.py:EnrichedZoneState","type":"calls"},{"source":"file:outputs/writer.py","target":"class:outputs/writer.py:OutputWriter","type":"contains"},{"source":"file:outputs/writer.py","target":"function:outputs/writer.py:write","type":"contains"},{"source":"file:outputs/writer.py","target":"class:outputs/writer.py:OutputWriter","type":"exports"},{"source":"document:FLOW.md","target":"file:orchestrator.py","type":"documents"},{"source":"document:FLOW.md","target":"file:data_source.py","type":"documents"},{"source":"document:FLOW.md","target":"file:inputs.py","type":"documents"},{"source":"document:FLOW.md","target":"file:config.py","type":"documents"},{"source":"document:FLOW.md","target":"file:parse.py","type":"documents"},{"source":"document:FLOW.md","target":"file:validate/forecast_gate.py","type":"documents"},{"source":"document:FLOW.md","target":"file:zone_detection.py","type":"documents"},{"source":"document:FLOW.md","target":"file:graph/message_passing.py","type":"documents"},{"source":"document:FLOW.md","target":"file:graph/zone_state.py","type":"documents"},{"source":"document:FLOW.md","target":"file:coordination/common.py","type":"documents"},{"source":"document:FLOW.md","target":"file:coordination/agents.py","type":"documents"},{"source":"document:FLOW.md","target":"file:coordination/negotiation.py","type":"documents"},{"source":"document:FLOW.md","target":"file:coordination/coordinators.py","type":"documents"},{"source":"document:FLOW.md","target":"file:generate/zone_worker.py","type":"documents"},{"source":"document:FLOW.md","target":"file:generate/rules.py","type":"documents"},{"source":"document:FLOW.md","target":"file:generate/schema.py","type":"documents"},{"source":"document:FLOW.md","target":"file:generate/det_guards.py","type":"documents"},{"source":"document:FLOW.md","target":"file:llm_client.py","type":"documents"}],"layers":[{"id":"layer:orchestration","name":"Pipeline Orchestration","description":"The run_scenario entry path that sequences the MASTRA stages from parsing to override gates for the evaluation runner and dashboard, with the package root and the FLOW.md guide that walks those stages."},{"id":"layer:coordination","name":"Agent Coordination","description":"The shared zone-agent interface, conflict definition, round-based negotiation among topology neighbours, and centralized coordinators that keep zones from rerouting onto the same road."},{"id":"layer:advisory-generation","name":"Advisory Generation","description":"Producers of per-zone JSON advisories and reroutes: the deterministic rule generator, the LLM zone worker with its retry loop, the LLM Global Supervisor, and the evaluation-only LLM plausibility check."},{"id":"layer:validation-gates","name":"Validation and Safety Gates","description":"Deterministic checks around the LLM and rule outputs: forecast plausibility, the advisory schema and reroute road validity, CONGESTED_TARGET retry errors, and the sensor-fault, severe-speed, cascade-risk and rush-hour overrides."},{"id":"layer:forecast-zone-analysis","name":"Forecast and Zone Analysis","description":"Turns PEMS-BAY data and Adaptive-LSTGAN forecasts into enriched zone states by loading scenarios, deriving per-sensor severity, clustering congested sensors with DBSCAN, and running two-round message passing between zones."},{"id":"layer:foundation","name":"Configuration and Shared Contracts","description":"The most widely imported modules: pinned constants and model IDs in config.py, the PipelineInput and run-result dataclasses in inputs.py, and the logging LLM client that raises rather than silently mocking."},{"id":"layer:outputs","name":"Run Outputs","description":"Writes the integrated plan and evaluation results as JSON into a per-run directory; no other module in this package imports it, so it is called from outside the pipeline package if at all."}]}