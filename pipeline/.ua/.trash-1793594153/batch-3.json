    {
      "id": "file:data_source.py",
      "type": "file",
      "name": "data_source.py",
      "filePath": "data_source.py",
      "summary": "Loads the real PEMS-BAY test data, Adaptive-LSTGAN forecasts and adjacency matrices, builds the agent communication topologies, and assembles per-sample PipelineInput objects plus stratified evaluation scenarios.",
      "tags": [
        "data-loading",
        "graph-topology",
        "scenario-sampling",
        "factory",
        "service"
      ],
      "complexity": "complex",
      "languageNotes": "Uses functools.lru_cache on loaders so the test DataFrame, station table and forecast arrays are read from disk only once per process."
    },
